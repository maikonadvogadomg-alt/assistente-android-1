{
	"appId": "com.skjuridico.app",
	"appName": "SK Jurídico IA",
	"webDir": "artifacts/assistente-juridico/dist",
	"server": {
		"url": "https://seu-servidor.replit.app",
		"cleartext": false,
		"androidScheme": "https",
		"hostname": "app.skjuridico",
		"allowNavigation": [
			"seu-servidor.replit.app"
		]
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 2500,
			"launchAutoHide": true,
			"backgroundColor": "#0d1a0a",
			"androidSplashResourceName": "splash",
			"androidScaleType": "CENTER_CROP",
			"showSpinner": true,
			"androidSpinnerStyle": "large",
			"iosSpinnerStyle": "large",
			"spinnerColor": "#6aad45",
			"splashFullScreen": true,
			"splashImmersive": true
		},
		"StatusBar": {
			"style": "Dark",
			"backgroundColor": "#0d1a0a"
		},
		"Keyboard": {
			"resize": "body",
			"resizeOnFullScreen": true
		},
		"PushNotifications": {
			"presentationOptions": [
				"badge",
				"sound",
				"alert"
			]
		},
		"LocalNotifications": {
			"smallIcon": "ic_stat_juridico",
			"iconColor": "#6aad45"
		},
		"CapacitorHttp": {
			"enabled": true
		}
	},
	"android": {
		"allowMixedContent": false,
		"captureInput": true,
		"webContentsDebuggingEnabled": false
	},
	"ios": {
		"contentInset": "automatic",
		"allowsLinkPreview": false,
		"scrollEnabled": true,
		"limitsNavigationsToAppBoundDomains": true
	}
}
